    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "check:live-seo": "node scripts/check-live-seo.mjs",
    "test:browser": "playwright test",
    "test": "npm run typecheck && npm run build && npm run test:seo && npm run test:browser"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
