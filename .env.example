# ============================================================
# Smart Printing Packaging — environment variables
# Copy to `.env` (local scripts) and add the same keys to
# Cloudflare Pages → Settings → Environment variables.
# ============================================================

# Neon connection string (use the "-pooler" host in production).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Admin account created/updated by `npm run db:setup`
ADMIN_EMAIL="admin@smartpackagingbd.com"
ADMIN_PASSWORD="ChangeMe12345"
ADMIN_NAME="Smart Printing Admin"

# Public base URL of the R2 bucket / custom domain (no trailing slash).
R2_PUBLIC_BASE_URL="https://media.smartpackagingbd.com"

# Optional
# R2_UPLOAD_MAX_MB="8"
# SITE_URL="https://smartpackagingbd.com"
# DEPLOY_HOOK_URL="https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxx"
# CATALOG_API_URL="https://smartpackagingbd.com"   # build-time sitemap for landing pages
